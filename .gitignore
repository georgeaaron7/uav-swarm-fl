# Python
__pycache__/
*.pyc
.venv/

# Dataset (re-create with: python prepare_data.py)
data/

# Model checkpoints
*.pt

# Throwaway runs
results/smoke_test/
results/*smoke*/
results/benchmark/
results/trace_validation/

# Full GPU benchmark run trees are packaged into a reviewable archive. Keep the
# local extracted copy (including checkpoints) without adding thousands of
# generated files to Git.
results/benchmark_gpu/seed*/
results/benchmark_gpu/benchmark_raw_results.tar.gz

# Context studies retain compact reports, not per-run logs/configs/checkpoints.
results/context_*/seed*/
results/context_*/study_manifest.json

# In-progress recovery mirror; publish compact reports after final validation.
results/context_final_gpu/

# LaTeX build output (paper/main.pdf is committed on purpose). Scoped to the
# document folders: results/ keeps experiment *.log files under version control.
/paper/**/*.aux
/paper/**/*.bbl
/paper/**/*.blg
/paper/**/*.log
/paper/**/*.out
/paper/**/*.synctex.gz
/report/**/*.aux
/report/**/*.bbl
/report/**/*.blg
/report/**/*.log
/report/**/*.out
/report/**/*.synctex.gz
/paper_overleaf.zip
/report_overleaf.zip

# Downloaded IEEE PDFs (copyrighted; keep out of the public repo)
/base_papers/

# SwarmCompute local state and build caches
.swarmcompute/
*.egg-info/
web/node_modules/
web/test-results/
web/playwright-report/
web/*.tsbuildinfo
.impeccable/review/
.impeccable/tmp/

/build/
/dist/
