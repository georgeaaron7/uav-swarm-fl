      "html": "<nav class=\"ds-nav\" aria-label=\"Preview navigation\"><a href=\"#overview\" aria-current=\"page\">Overview</a><a href=\"#workers\">Workers</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;padding:18px 14px;background:#111a25;width:198px;font:13px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-nav a{padding:12px 14px;color:#a8b9cd;border-radius:5px;text-decoration:none}.ds-nav a:hover{background:#1a2838;color:white}.ds-nav a[aria-current]{background:#253a51;color:#c1e3ff}.ds-nav a:focus-visible{outline:2px solid #aed9fb;outline-offset:4px}"
    },
    {
      "name": "Outcome status",
      "kind": "chip",
      "description": "Text-and-dot states preserve outcome meaning without a pill container.",
