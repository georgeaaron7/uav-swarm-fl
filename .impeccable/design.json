      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Pale blue emphasis for a primary form or enrollment action.",
      "html": "<button class=\"ds-primary\">Save settings</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:14px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;padding:9px 13px;border:1px solid #46566c;border-radius:6px;cursor:pointer;white-space:nowrap;transition:background .16s ease-out;background:#a5d0f2;color:#13283c;border-color:#a5d0f2;font-weight:650}.ds-primary:hover{background:#c3e1f7}.ds-primary:focus-visible{outline:2px solid #aed9fb;outline-offset:4px}.ds-primary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
