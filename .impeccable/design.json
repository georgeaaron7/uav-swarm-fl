      "css": ".ds-states{display:flex;gap:20px;flex-wrap:wrap}.ds-status{display:inline-flex;align-items:center;gap:7px;font:11px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;white-space:nowrap}.ds-status::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}.ds-success{color:#86cfb3}.ds-diverged{color:#e4bb76}.ds-danger{color:#f3a0a1}"
    },
    {
      "name": "Terminal progress surface",
      "kind": "card",
      "refersTo": "study-progress",
      "description": "Flat full-width progress strip; preview contains no fabricated measurements.",
      "html": "<section class=\"ds-progress\"><h2>Study progress</h2><p>Successful and scientifically diverged runs count as terminal.</p><progress max=\"1\" value=\"0\" aria-label=\"Terminal experiments\"></progress></section>",
      "css": ".ds-progress{padding:24px;background:#1b2736;border-radius:9px;color:#e4edf7;font:14px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-progress h2{font-size:17px;font-weight:620;letter-spacing:-.01em;margin:0}.ds-progress p{font-size:12px;line-height:1.6;color:#a4b3c5;margin:6px 0 22px}.ds-progress progress{display:block;width:100%;height:8px;border:none;border-radius:5px;overflow:hidden;background:#34445a;accent-color:#8fc6ee}.ds-progress progress::-webkit-progress-bar{background:#34445a}.ds-progress progress::-webkit-progress-value{background:#8fc6ee;border-radius:5px}.ds-progress progress::-moz-progress-bar{background:#8fc6ee}"
    },
    {
      "name": "Empty state",
      "kind": "card",
      "refersTo": "empty-state",
      "description": "A quiet surface with a concrete next step.",
      "html": "<section class=\"ds-empty\"><h3>Start with a pilot study</h3><p>Prepare the datasets, plan a study, and review its jobs before starting workers.</p></section>",
      "css": ".ds-empty{padding:42px 24px;background:#1a2635;border-radius:7px;color:#e4edf7;font:14px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-empty h3{font-size:16px;font-weight:600;margin:0 0 8px}.ds-empty p{font-size:13px;line-height:1.6;color:#a4b3c5;max-width:75ch;margin:0}"
    },
    {
      "name": "Inline error",
      "kind": "custom",
      "refersTo": "error",
      "description": "Alert appearance for actual API and action errors; sample text labels this as a preview.",
      "html": "<div class=\"ds-error\" role=\"alert\">Error feedback preview</div>",
      "css": ".ds-error{border:1px solid #87565e;background:#332731;color:#f5b9bd;padding:13px 16px;border-radius:6px;font:13px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;overflow-wrap:anywhere}"
    },
    {
      "name": "Participation mode",
      "kind": "input",
      "refersTo": "input",
      "description": "Owner-permitted native participation selector; changes apply after worker acknowledgment at the next experiment.",
      "html": "<label class=\"ds-mode\">Participation mode<select aria-label=\"Participation mode\"><option>Light · one CPU thread, wait for low activity</option><option selected>Balanced · two CPU threads</option><option>Dedicated · more CPU threads, one GPU job</option></select></label>",
      "css": ".ds-mode{display:flex;flex-direction:row;align-items:center;gap:8px;color:#c6d3e3;font:12px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-mode select{font:14px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;border:1px solid #4b5d74;background:#172230;color:#e4edf7;padding:10px 12px;border-radius:5px;min-width:0;width:auto;color-scheme:dark}.ds-mode select:focus-visible{outline:2px solid #aed9fb;outline-offset:4px}@media(max-width:760px){.ds-mode{flex-direction:column;align-items:stretch;font-size:11px}.ds-mode select{font-size:12px;width:100%}}"
    }
  ],
  "narrative": {
    "northStar": "The Compact Operations Console",
    "overview": "A compact dark operations console built directly in code. Blue slate layers, system typography and restrained color keep queue state, worker participation and scientific outcomes easy to scan. Functional SVG icons and measured data supply the visual detail.\n\nThe user pinned this world and code-first construction. Preserve its familiar controls, dense data presentation and explicit state labels. The interface ships without generated imagery or raster decoration.",
    "keyCharacteristics": [
      "Dense, readable operations layouts.",
      "Flat slate surfaces with pale blue actions.",
      "Tabular measurements and explicit outcome labels.",
      "Responsive navigation and purposeful feedback.",
      "Code-built controls, charts and SVG icons."
    ],
    "rules": [
      {
        "name": "The Outcome Rule",
        "body": "Pair every status color with readable state text. Keep scientific divergence amber and infrastructure failure red.",
        "section": "colors"
      },
      {
        "name": "The Measurement Rule",
        "body": "Use tabular numerals for statistics, progress counts, tables and event times; show unknown measurements as an em dash.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate ordinary content with tone, spacing and rules. Reserve the implemented shadow for the enrollment popover.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep status text alongside semantic color.",
      "Do preserve compact system typography and tabular measurements.",
      "Do let wide tables scroll horizontally while forms and section layouts reflow.",
      "Do provide task-specific empty messages and inline error feedback.",
      "Do retain the visible Live updates / Polling every 10s connection label.",
      "Do use code, CSS and SVG for this console’s visual assets."
    ],
    "donts": [
      "Don’t introduce generated or decorative shipping rasters.",
      "Don’t fabricate activity, performance, sensor readings or ETA.",
      "Don’t style ordinary sections as floating cards with ambient shadows.",
      "Don’t replace labeled outcomes with color alone.",
      "Don’t use animated charts or decorative live pulses.",
      "Don’t hide unavailable measurements behind invented values."
    ]
  }
}
