      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;color:#c6d3e3;font:13px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-field input{font:14px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;border:1px solid #4b5d74;background:#172230;color:#e4edf7;padding:10px 12px;border-radius:5px;min-width:0;caret-color:#b3daf9}.ds-field input::placeholder{color:#a0afc1}.ds-field input:focus-visible{outline:2px solid #aed9fb;outline-offset:4px}"
    },
