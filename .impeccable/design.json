      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Compact secondary task action.",
      "html": "<button class=\"ds-secondary\">Refresh</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:14px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;padding:9px 13px;border:1px solid #46566c;border-radius:6px;cursor:pointer;white-space:nowrap;transition:background .16s ease-out;background:#253449;color:#e4edf7}.ds-secondary:hover{background:#35465e}.ds-secondary:focus-visible{outline:2px solid #aed9fb;outline-offset:4px}.ds-secondary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
